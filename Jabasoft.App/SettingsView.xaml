<UserControl x:Class="Jabasoft.App.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="SettingsView_Loaded">

    <!-- Host voor het live uit de Stylebook-database geladen "Instellingen"-
         component (zie SettingsView.xaml.cs) - opnieuw geladen bij elke
         Loaded, zodat een stylewijziging zichtbaar is zodra je hier
         terugkomt, zonder Jabasoft.App te hoeven herstarten. -->
    <ContentControl x:Name="Host" />
</UserControl>
