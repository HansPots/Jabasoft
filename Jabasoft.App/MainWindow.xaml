<Window x:Class="Jabasoft.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Stylebook.Components.Controls;assembly=Stylebook.Components"
        Title="Jabasoft" Height="1080" Width="1920"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <!-- Een hele app-rij is de knop (niet alleen een "Start"-tekstje
             ernaast) - groter klikvlak, en de rij toont zijn eigen
             hover/pressed-status net als de knoppen in Stylebook.
             Beschikbaarheid (IsEnabled) wisselt Foreground/Background
             expliciet, want WPF's standaard "disabled" grijs komt uit
             SystemColors, niet uit onze eigen tokens. -->
        <Style x:Key="AppEntryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusMedium}"
                                Padding="{StaticResource SpaceMedium}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Klein vierkant icoonknopje voor de Actie-rail (48px breed) -
             puur functioneel neergezet, bewust geen verdere opmaak: gaat
             later via de Stylebook gestyled worden (zie
             MainWindow.xaml.cs's project-memory-comment). -->
        <Style x:Key="IconActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource RadiusMedium}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Zelfde vaste Basis-schil (Header/Menu/Inhoud/Actie/Footer) als elk
         JabaSoft-app-venster, zie project-memory. Venstermaat 1920x1080 -
         de familie-standaard voor elke app behalve Stylebook (die blijft
         breder, voor zijn drie-kolommen-opmaak). Regio-invulling voor
         Jabasoft v1 bewust minimaal/functioneel: de app-launcherlijst in
         het Menu-vak (dezelfde plek als Stylebook's eigen MENU-strook),
         Header/Footer/Inhoud met simpele placeholders, Actie met de
         instellingen-knop, tot dit via Stylebook gestyled wordt. -->
    <controls:Basis x:Name="AppShell">
        <controls:Basis.HeaderContent>
            <TextBox Text="JABASOFT"
                     Style="{StaticResource SelectableTextStyle}"
                     FontSize="{StaticResource FontSizeTitle}"
                     FontWeight="Bold" />
        </controls:Basis.HeaderContent>

        <!-- MenuContent (de app-lijst) en ActionContent (de instellingen-
             knop) worden in code-behind opgebouwd en toegewezen (zie
             MainWindow.xaml.cs) - x:Name op een element DAT als
             property-waarde aan Basis wordt meegegeven botst met Basis'
             eigen naam-scope (MC3093), dus kunnen ze hier niet direct met
             x:Name in XAML staan. -->

        <controls:Basis.FooterContent>
            <TextBox Text="Gereed"
                     Style="{StaticResource SelectableTextStyle}"
                     Foreground="{DynamicResource TextMutedBrush}" />
        </controls:Basis.FooterContent>

        <!-- MainContent (Inhoud) - via Basis' [ContentProperty]. -->
        <TextBox Text="Kies een applicatie in het menu om te starten."
                 Style="{StaticResource SelectableTextStyle}"
                 Foreground="{DynamicResource TextMutedBrush}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />
    </controls:Basis>
</Window>
