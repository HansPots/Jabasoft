<Window x:Class="Jabasoft.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:apps="clr-namespace:Jabasoft.App.Paginas"
        Title="Jabasoft" Height="1080" Width="1920"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource BackgroundBrush}">

    <!-- Geen titelbalk van Windows: de header heeft zijn eigen
         vensterknopjes (Controls/WindowControlButtons) en zou er anders
         twee boven elkaar krijgen.

         WindowStyle="None" alleen is niet genoeg - dan raak je met de
         titelbalk ook alles kwijt wat Windows eraan vasthangt: slepen,
         randen pakken om te verslepen, en een gemaximaliseerd venster dat
         netjes voor de taakbalk stopt. WindowChrome geeft dat terug:

         - CaptionHeight 0: Windows claimt zelf GEEN sleepstrook bovenin.
           Dat doet de header zelf (Regios/Header/Hoofdbalk), want alleen
           de bovenste strook daarvan mag slepen - de infoblokken eronder
           hebben splitters die je moet kunnen pakken.
         - ResizeBorderThickness 6: de onzichtbare rand waarmee je het
           venster groter of kleiner sleept.
         - GlassFrameThickness 0 en CornerRadius 0: geen schaduwrand en
           geen afgeronde hoeken van Windows eroverheen; de vorm komt
           volledig uit het thema. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Een hele app-rij is de knop (niet alleen een "Start"-tekstje
             ernaast) - groter klikvlak, en de rij toont zijn eigen
             hover/pressed-status net als de knoppen in Stylebook.
             Beschikbaarheid (IsEnabled) wisselt Foreground/Background
             expliciet, want WPF's standaard "disabled" grijs komt uit
             SystemColors, niet uit onze eigen tokens. -->
        <Style x:Key="AppEntryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusMedium}"
                                Padding="{StaticResource SpaceMedium}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Klein vierkant icoonknopje voor de Actie-rail (48px breed) -
             puur functioneel neergezet, bewust geen verdere opmaak: gaat
             later via de Stylebook gestyled worden (zie
             MainWindow.xaml.cs's project-memory-comment). -->
        <Style x:Key="IconActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource RadiusMedium}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Jabasoft's paginaschil (Paginas/Hoofdscherm.xaml) - een Basis uit
         Stylebook.Components met daarin onze eigen Hoofdbalk en
         Statusbalk. Menu/Inhoud/Actie geeft die schil door aan zijn eigen
         MenuContent/MainContent/ActionContent, precies zoals Basis zelf
         werkt. Venstermaat 1920x1080 - de familie-standaard voor elke app
         behalve Stylebook (die blijft breder, voor zijn
         drie-kolommen-opmaak).

         De schermen van deze app staan in DIT project (Paginas/ en
         Regios/), niet in Stylebook.Components: die bibliotheek levert de
         gedeelde bouwstenen, wij zetten ze hier in elkaar. Het Menu is
         wel zo'n gedeelde bouwsteen (Navigatiemenu), met de knoppen
         Main/Stylebook/Settings; de oude app-launcherlijst is vervallen,
         alleen Stylebook is als knop overgebleven. -->
    <apps:Hoofdscherm x:Name="AppShell">
        <!-- Menu, Inhoud en Actie worden alle drie in code-behind gevuld
             (zie MainWindow.xaml.cs): het Navigatiemenu, het scherm waar
             dat menu naartoe schakelt, en de instellingen-knop. Ze kunnen
             hier niet met x:Name in XAML staan - een x:Name'd element DAT
             als property-waarde aan Hoofdscherm wordt meegegeven botst met
             diens eigen naam-scope (MC3093). Vandaar ook geen inhoud meer
             tussen deze tags: het inhoudsvak wordt bij het opstarten
             meteen op het Hoofdscherm-component gezet. -->
    </apps:Hoofdscherm>
</Window>
