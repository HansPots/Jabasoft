<UserControl x:Class="Jabasoft.App.Controls.Setting02"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" Width="1568">

    <!-- Design-time-only: geeft Visual Studio/Blend's Designer een
         thema-context (kleuren, lettertype) - deze class library heeft
         zelf geen App.xaml die dat normaal doet. mc:Ignorable="d" zorgt
         dat dit bij het echt compileren/draaien volledig wegvalt. -->
    <d:UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </d:UserControl.Resources>

    <!--
        Instellingenkaart 2 van 3: FONT. Lettertypekeuze, tekstgrootte met
        een schuifbalk, een voorbeeldvak en een terugzetknop.

        Zelfde breedte (1568) en kaartopmaak als kaart 1 en 3; hoogte volgt
        de inhoud. De schuifbalk en de knop gebruiken de gedeelde stijlen
        SliderAccentStyle/AccentButtonStyle uit Styles/Controls.xaml - die
        staan daar en niet hier, omdat kaart 3 ze ook gebruikt.

        De waarden zijn nu vast (Segoe UI, 16 px). ValueText, FontPicker en
        SizeSlider hebben een naam, zodat ze later vanuit code-behind aan
        de echte instelling gekoppeld kunnen worden.
    -->
    <!-- De breedte staat op het UserControl hierboven (1568) en niet meer
         op deze Border. Zo blijft de kaart op zichzelf even breed als
         altijd - ook op het Regions-canvas in het Stylebook - maar kan wie
         hem plaatst er Width="Auto" op zetten en hem laten meerekken. Dat
         doet Regions/Inhoud/Instellingen, zodat het instellingenscherm in
         de app geen horizontale schuifbalk nodig heeft. -->
    <Border MinWidth="480" CornerRadius="{DynamicResource RadiusMedium}" BorderThickness="{DynamicResource RegionBorderThickness}"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            HorizontalAlignment="Stretch" VerticalAlignment="Top">
        <StackPanel Margin="20,16">
            <TextBlock Text="{DynamicResource T_FontTitel}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text01Brush}" />

            <TextBlock Text="{DynamicResource T_FontKeuze}" Margin="0,14,0,4" FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <ComboBox x:Name="FontPicker" Height="34" SelectedIndex="0" SelectionChanged="FontPicker_SelectionChanged">
                <ComboBoxItem Content="Segoe UI" />
                <ComboBoxItem Content="Inter" />
            </ComboBox>

            <TextBlock x:Name="SizeLabel" Text="Text size (16 px)" Margin="0,16,0,6"
                       FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <Slider x:Name="SizeSlider" Minimum="10" Maximum="28" Value="16" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SizeSlider_ValueChanged"
                    Style="{DynamicResource SliderAccentStyle}" />

            <!-- Voorbeeldvak met stippellijn. Een Border kan in WPF geen
                 streepjesrand tekenen (BorderBrush kent geen StrokeDashArray),
                 vandaar een Rectangle als rand met de tekst eroverheen. -->
            <Grid Height="42" Margin="0,16,0,0">
                <Rectangle RadiusX="4" RadiusY="4" StrokeThickness="1" StrokeDashArray="4 3"
                           Stroke="{DynamicResource BorderBrush}" Fill="Transparent" />
                <TextBlock x:Name="PreviewText" Text="{DynamicResource T_FontVoorbeeld}"
                           Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                           Foreground="{DynamicResource Text01Brush}" />
            </Grid>

            <Button x:Name="ResetFontButton" Content="{DynamicResource T_FontTerug}"
                    Margin="0,16,0,0" Click="ResetFont_Click" Style="{DynamicResource AccentButtonStyle}" />
        </StackPanel>
    </Border>

</UserControl>
