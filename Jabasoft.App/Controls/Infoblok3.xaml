<UserControl x:Class="Jabasoft.App.Controls.Infoblok3"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" Height="166" Width="450">

    <!-- Design-time-only: geeft Visual Studio/Blend's Designer een
         thema-context (kleuren, lettertype) - deze class library heeft
         zelf geen App.xaml die dat normaal doet. mc:Ignorable="d" zorgt
         dat dit bij het echt compileren/draaien volledig wegvalt. -->
    <d:UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </d:UserControl.Resources>

    <!--
        Header-regio component: kopie van Infoblok2 (zelfde 450x166 kader en
        gekleurde titelbalk), maar met het bodytekstblok vervangen door een
        tabel van rijen met twee kolommen - links het label, rechts de
        waarde. De inhoud is voorbeeldtekst; kleuren via DynamicResource,
        volgt dus het actieve thema. Te bekijken via Stylebook.Playground's
        Bibliotheek-modus.
    -->
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="2"
            CornerRadius="6"
            HorizontalAlignment="Stretch">
        <StackPanel>
            <!-- Hoekstraal 4, niet 6: de buitenrand heeft straal 6 met een
                 rand van 2px, dus de BINNENkant van die rand loopt op 6-2=4.
                 Met 6 loopt de bocht van deze balk niet mee met de bocht van
                 de rand en zie je in beide bovenhoeken een kiertje
                 SurfaceBrush tussen de rand en het blok. -->
            <!-- Vaste hoogte, daarom alleen horizontale padding; de TextBlock
                 centreert zichzelf verticaal. Padding links 8 = dezelfde
                 inspringing als de tabel hieronder (Grid Margin links 8),
                 zodat "InfoBlok" en de eerste kolom exact onder elkaar beginnen. -->
            <Border Background="{DynamicResource BorderBrush}" CornerRadius="4,4,0,0" Height="24" Padding="8,0">
                <TextBlock Text="InfoBlok" FontSize="18" Foreground="{DynamicResource Text01Brush}" VerticalAlignment="Center" TextWrapping="Wrap" Height="24" HorizontalAlignment="Left" TextAlignment="Center" />
            </Border>
            <!-- Hoogte 116 = dezelfde bodyhoogte als Infoblok2, zodat dit
                 component even hoog blijft. Laatste rij is "*": die vangt de
                 overgebleven ruimte op, zodat de rijen bovenaan blijven
                 staan in plaats van over de hoogte uit te rekken. -->
            <Grid Margin="8" Height="116">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Kolom 1" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Kolom 2" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Snelheid" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="112" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Afstand" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="353" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
            </Grid>
        </StackPanel>
    </Border>

</UserControl>
