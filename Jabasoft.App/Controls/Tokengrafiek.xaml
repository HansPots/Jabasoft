<UserControl x:Class="Jabasoft.App.Controls.Tokengrafiek"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" Width="1568">

    <!-- Design-time-only: geeft Visual Studio/Blend's Designer een
         thema-context (kleuren, lettertype) - deze class library heeft
         zelf geen App.xaml die dat normaal doet. mc:Ignorable="d" zorgt
         dat dit bij het echt compileren/draaien volledig wegvalt. -->
    <d:UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </d:UserControl.Resources>

    <!--
        Het verloop van het tokenverbruik per model: een lijn per model, met
        de tokens per dag over de laatste vier weken - onder het totaal, over
        de volle breedte van het scherm.

        De lijnen worden in code-behind getekend (zie Tokengrafiek.xaml.cs) op
        een Canvas: hoeveel modellen er zijn hangt af van wat er in de
        database staat. De legenda eronder heeft per model ook zijn totaal.

        Zelfde kaartopmaak als het totaal en de weekkaarten, zodat het
        tokenscherm herkenbaar bij elkaar hoort.
    -->
    <Border MinWidth="480" CornerRadius="{DynamicResource RadiusMedium}" BorderThickness="{DynamicResource RegionBorderThickness}"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            HorizontalAlignment="Stretch" VerticalAlignment="Top">
        <StackPanel Margin="20,16">
            <TextBlock Text="{DynamicResource T_TokensVerloopTitel}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text01Brush}" />
            <TextBlock x:Name="Onderschrift" Margin="0,6,0,0"
                       FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Text="{DynamicResource T_TokensVerloopLeeg}" />

            <Canvas x:Name="Vlak" Height="240" Margin="0,12,0,0" ClipToBounds="True"
                    AutomationProperties.AutomationId="TokensGrafiek" />

            <WrapPanel x:Name="Legenda" Margin="0,8,0,0" />
        </StackPanel>
    </Border>

</UserControl>
