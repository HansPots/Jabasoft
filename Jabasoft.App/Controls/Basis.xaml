<UserControl x:Class="Jabasoft.App.Controls.Basis"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="1920" d:DesignHeight="1080">

    <!-- Design-time-only: geeft Visual Studio/Blend's Designer een
         thema-context (kleuren, lettertype) - deze class library heeft
         zelf geen App.xaml die dat normaal doet. mc:Ignorable="d" zorgt
         dat dit bij het echt compileren/draaien volledig wegvalt. -->
    <d:UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </d:UserControl.Resources>

    <!--
        Standaard app-schil: header en footer over de volle breedte,
        daartussen een vaste linker menustrook en een vaste rechter
        actiestrook rond de meebewegende hoofdinhoud. Elke regio heeft een
        eigen content-slot (HeaderContent/MenuContent/MainContent/
        ActionContent/FooterContent, zie Basis.xaml.cs) - géén ervan heet
        "Content", want die inherited property is al intern in gebruik
        voor deze rij/kolom-Grid zelf.

        Vaste maten: Header 210, Footer 24, Menu 256, Actie 48. Alleen de
        hoofdinhoud is variabel (kolom 2 en rij 1, allebei "*").

        Die maten staan NIET meer als getal op de rij of de kolom; die
        staan op Auto en volgen wat erin zit. Zo gaat de SPACING-rand er
        niet vanaf maar komt hij erbij, en houdt het blok zelf zijn maat.
        Het menu (256) is de uitzondering: dat is nog een vaste kolom, dus
        daar gaat de rand wel van de 256 af.

        Elk van de vijf blokken geeft ruimte aan zijn LINKER- en BOVENkant,
        zo groot als de SPACING-instelling (Controls/Setting-04, via
        Theming/LayoutManager). Niet rondom: dan zouden
        twee blokken naast elkaar allebei een marge meebrengen en zag je
        het dubbele van wat je instelt. Zo is elke ruimte precies de
        ingestelde waarde. De onderste en rechterrand van de pagina hebben
        geen buur die het kan doen; die komt van de opvulling op de Border
        hieronder.

        De achtergrond staat daarom op die Border - dat is wat je in al die
        ruimtes ziet.

        De blokken hebben GEEN randlijn meer. Die 1px BorderBrush-lijnen
        tussen header/menu/inhoud/actie/footer waren de lichte strepen die
        je over het hele scherm zag lopen. De scheiding tussen de blokken
        komt nu van SPACING: zet je die op 0, dan is het scherm één vlak.
    -->

    <!-- De omhullende opvulling doet de onderste en rechterrand van de
         pagina: de blokken hieronder geven alleen ruimte aan hun linker- en
         bovenkant, en daar is aan die twee randen geen buur voor. -->
    <Border Background="{DynamicResource BackgroundBrush}"
            Padding="{DynamicResource RegionGapEndThickness}">
    <Grid>
        <Grid.RowDefinitions>
            <!-- Auto en geen vaste 210 en 24: de rij is dan precies zo hoog
                 als wat erin staat PLUS de SPACING-rand eromheen. Die rand
                 gaat dus niet meer van de beschikbare hoogte af - anders
                 hield de footer bij 5 px nog maar 14 px over voor pillen
                 die 24 hoog zijn, en werden die afgeknipt. De middenrij
                 staat op "*" en vangt het verschil op, dus de pagina blijft
                 1920x1080.

                 Auto en niet een meegroeiende maat via DynamicResource: op
                 een RowDefinition pikt die een latere wijziging niet op, en
                 dan verspringt er bij het schuiven niets. -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: volle breedte, vaste hoogte -->
        <Border Grid.Row="0"
                Margin="{DynamicResource RegionGapLeftTopThickness}"
                Background="{DynamicResource SurfaceBrush}">
            <ContentPresenter Content="{Binding HeaderContent, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch" />
        </Border>

        <!-- Midden: menu | hoofdinhoud | action, elk vaste breedte behalve de hoofdinhoud -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="256" />
                <ColumnDefinition Width="*" />
                <!-- Auto en geen vaste 48: de kolom voegt zich naar de
                     actierail PLUS de SPACING-rand eromheen, in plaats van
                     dat die rand van de 48 afgaat. De rail zelf blijft dus
                     altijd 48 breed, wat je de spacing ook geeft. -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="{DynamicResource RegionGapLeftTopThickness}"
                    Background="{DynamicResource SurfaceBrush}">
                <ContentPresenter Content="{Binding MenuContent, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch" />
            </Border>

            <Border Grid.Column="1"
                    Margin="{DynamicResource RegionGapLeftTopThickness}"
                    Background="{DynamicResource BackgroundBrush}">
                <ContentPresenter Content="{Binding MainContent, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch" />
            </Border>

            <Border Grid.Column="2"
                    Margin="{DynamicResource RegionGapLeftTopThickness}"
                    Background="{DynamicResource SurfaceBrush}">
                <ContentPresenter Content="{Binding ActionContent, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch" />
            </Border>
        </Grid>

        <!-- Footer: volle breedte, vaste hoogte -->
        <Border Grid.Row="2"
                Margin="{DynamicResource RegionGapLeftTopThickness}"
                Background="{DynamicResource SurfaceBrush}">
            <ContentPresenter Content="{Binding FooterContent, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch" />
        </Border>
    </Grid>
    </Border>

</UserControl>
