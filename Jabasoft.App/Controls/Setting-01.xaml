<UserControl x:Class="Jabasoft.App.Controls.Setting01"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" Width="1568">

    <!-- Design-time-only: geeft Visual Studio/Blend's Designer een
         thema-context (kleuren, lettertype) - deze class library heeft
         zelf geen App.xaml die dat normaal doet. mc:Ignorable="d" zorgt
         dat dit bij het echt compileren/draaien volledig wegvalt. -->
    <d:UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </d:UserControl.Resources>

    <UserControl.Resources>
        <!--
            Themakeuze-knop: een echte RadioButton (dus ook echt klikbaar en
            onderling uitsluitend via GroupName), maar met een eigen template
            zodat hij eruitziet als een pilknop met een stip in plaats van
            WPF's standaard rondje-met-tekst. Gekozen = accentkleur voor rand,
            stip en tekst; niet gekozen = de gewone randkleur.
        -->
        <Style x:Key="ThemeChoiceStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Text01Brush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="6" BorderThickness="1" Padding="14,0"
                                Background="{DynamicResource BackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="Dot" Width="9" Height="9"
                                         Fill="{DynamicResource Text01Brush}" VerticalAlignment="Center" />
                                <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentBrush}" />
                                <!-- Zonder TargetName: geldt voor de RadioButton zelf, en de
                                     ContentPresenter erft die Foreground. -->
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!--
        Instellingenkaart 1 van 3: THEMA. De themakiezer van het
        instellingenscherm - twee pilknoppen naast elkaar.

        Breedte 1568 = de Inhoud-basis (1616) met 24 marge links en rechts;
        de andere twee kaarten hebben dezelfde breedte. GEEN vaste hoogte:
        de kaart groeit mee met zijn inhoud, zodat een extra thema erbij
        geen handmatige aanpassing vraagt.
    -->
    <!-- De breedte staat op het UserControl hierboven (1568) en niet meer
         op deze Border. Zo blijft de kaart op zichzelf even breed als
         altijd - ook op het Regions-canvas in het Stylebook - maar kan wie
         hem plaatst er Width="Auto" op zetten en hem laten meerekken. Dat
         doet Regions/Inhoud/Instellingen, zodat het instellingenscherm in
         de app geen horizontale schuifbalk nodig heeft. -->
    <Border MinWidth="480" CornerRadius="6" BorderThickness="2"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            HorizontalAlignment="Stretch" VerticalAlignment="Top">
        <StackPanel Margin="20,16">
            <TextBlock Text="THEMA" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text01Brush}" />
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <RadioButton x:Name="ThemeLcars" Content="LCARS" GroupName="Thema"
                             IsChecked="True" Checked="Theme_Checked" Style="{DynamicResource ThemeChoiceStyle}" />
                <RadioButton x:Name="ThemeVsCode" Content="VS Code" GroupName="Thema" Margin="8,0,0,0"
                             Checked="Theme_Checked" Style="{DynamicResource ThemeChoiceStyle}" />
            </StackPanel>
        </StackPanel>
    </Border>

</UserControl>
