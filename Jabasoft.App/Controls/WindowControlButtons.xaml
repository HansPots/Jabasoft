<UserControl x:Class="Jabasoft.App.Controls.WindowControlButtons"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <!-- Design-time-only: geeft Visual Studio/Blend's Designer een
         thema-context (kleuren, lettertype) - deze class library heeft
         zelf geen App.xaml die dat normaal doet. mc:Ignorable="d" zorgt
         dat dit bij het echt compileren/draaien volledig wegvalt. -->
    <d:UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </d:UserControl.Resources>

    <!-- Algemeen: rij van drie vensterknopjes (minimaliseren/herstellen/
         sluiten) - puur decoratief, geen echte window-commando's
         gekoppeld. Ook gebruikt (inline gekopieerd) in HpoHeader. -->
    <StackPanel Orientation="Horizontal">

        <Button Width="34" Height="32" Background="Transparent" BorderThickness="0"
                Foreground="{DynamicResource TextPrimaryBrush}"
                FontSize="{DynamicResource FontSizeTitle}"
                Content="&#8212;">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Herstellen: het vierkantje is getekend in plaats van het teken
             U+25A1. Dat teken zit niet in het app-lettertype; Windows valt dan
             terug op een lettertype waarin het maar 8x8 px wordt (gemeten bij
             FontSizeTitle), terwijl het kruisje 12x13 is. Dit kader is even
             groot als het kruisje en volgt de Foreground van de knop. -->
        <Button Width="34" Height="32" Background="Transparent" BorderThickness="0"
                Foreground="{DynamicResource TextPrimaryBrush}">
            <Border Width="12" Height="12" BorderThickness="2"
                    BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Button Width="34" Height="32" Background="Transparent" BorderThickness="0"
                Foreground="{DynamicResource TextPrimaryBrush}"
                FontSize="{DynamicResource FontSizeTitle}"
                Content="&#10005;">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

    </StackPanel>

</UserControl>
