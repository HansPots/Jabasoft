<UserControl x:Class="Jabasoft.App.Controls.Footer01"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" Width="288" Height="24">

    <!-- Design-time-only: geeft Visual Studio/Blend's Designer een
         thema-context (kleuren, lettertype) - deze class library heeft
         zelf geen App.xaml die dat normaal doet. mc:Ignorable="d" zorgt
         dat dit bij het echt compileren/draaien volledig wegvalt. -->
    <d:UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </d:UserControl.Resources>

    <!--
        Footerpil 1 van 5: SYSTEM HEALTH. Statuspil met een stiplampje en
        een toestandstekst, zonder voortgangsbalk - de enige van de vijf
        die alleen tekst toont. Hoogte 24 met hoekstraal 12 (= precies de
        helft), waardoor de uiteinden halve cirkels worden.

        De inhoud is nu vast; het lampje (StatusLamp) en de tekst
        (StatusText) hebben een naam zodat ze later vanuit code-behind op
        interval bijgewerkt kunnen worden.
        Breedte staat op het UserControl zelf en niet meer op de Border
        hieronder. Zo blijft de pil op zichzelf even breed als altijd,
        maar kan wie hem plaatst er Width="Auto" op zetten en hem laten
        meerekken met de ruimte die hij krijgt - dat doet de footer van
        Jabasoft (Regions/Footer/Statusbalk), waar de vijf pillen samen de
        breedte verdelen. De HOOGTE blijft altijd 24.
    -->
    <Border Height="24" CornerRadius="12"
            Background="{DynamicResource TextMutedBrush}"
            HorizontalAlignment="Stretch" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
            <Ellipse x:Name="StatusLamp" Width="8" Height="8" Opacity="0.65"
                     Fill="{DynamicResource Text01Brush}" VerticalAlignment="Center" />
            <TextBlock Text="SYSTEM HEALTH" Margin="8,0,0,0"
                       FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource Text01Brush}"
                       Opacity="0.85" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" Text="Ready" Margin="10,0,0,0"
                       FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text01Brush}" VerticalAlignment="Center" />
        </StackPanel>
    </Border>

</UserControl>
