<UserControl x:Class="Jabasoft.App.Controls.Setting06"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" Width="1568">

    <!-- Design-time-only: geeft Visual Studio/Blend's Designer een
         thema-context (kleuren, lettertype) - deze class library heeft
         zelf geen App.xaml die dat normaal doet. mc:Ignorable="d" zorgt
         dat dit bij het echt compileren/draaien volledig wegvalt. -->
    <d:UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </d:UserControl.Resources>

    <UserControl.Resources>
        <!--
            Serverkeuze-knop: dezelfde pilknop als de themakiezer op kaart 1.
            Bewust een eigen kopie en niet gedeeld: het Stylebook levert de
            gedeelde stijlen (SliderAccentStyle, AccentButtonStyle) en deze
            hoort daar nog niet bij - deze app bouwt zijn eigen kaarten.
        -->
        <Style x:Key="ServerChoiceStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Text01Brush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="{DynamicResource RadiusMedium}" BorderThickness="2" Padding="14,0"
                                Background="{DynamicResource BackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="Dot" Width="9" Height="9"
                                         Fill="{DynamicResource Text01Brush}" VerticalAlignment="Center" />
                                <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Invoerveld in themakleuren. Het Stylebook heeft wel een stijl
             voor een TextBox die als LABEL dienstdoet (SelectableTextStyle),
             maar nog geen echt invoerveld - vandaar hier. -->
        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="{DynamicResource RadiusMedium}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Eén regel in een modelkeuzelijst: naam, dan grootte · soort, dan de sterren.
             De sterren/denktijd zelf stel je niet hier in, maar onderaan de kaart in het
             blok MODELLEN (zie Setting-06.xaml.cs) - dit is alleen de weergave. -->
        <DataTemplate x:Key="ModelkeuzeTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Naam}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Info}" Margin="12,0,0,0" VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="{Binding SterrenTekst}" Margin="12,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}"
                           ToolTip="{DynamicResource T_AiSterrenTip}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <!--
        Instellingenkaart AI: welke AI-server er gebruikt wordt en met welke
        modellen. Dit is de enige kaart die iets instelt wat NIET van deze
        applicatie is: de waarde staat bij de broker en geldt dus voor alle
        JabaSoft-applicaties tegelijk. Vandaar ook geen terugzetknop zoals
        bij de andere kaarten - je zet het voor iedereen om.

        De keuzelijsten worden gevuld met de modellen die de broker op de
        ingestelde server aantreft. Is die niet bereikbaar, dan blijft de
        bewaarde naam gewoon staan en zegt de regel onderaan wat er aan de
        hand is - je instelling raak je er dus niet mee kwijt.

        De vijf keuzelijsten hierboven kiezen ALLEEN welk model welke taak
        doet. Kwaliteit, denktijd en een eigen notitie per model staan
        allemaal samen in het blok MODELLEN onderaan (zie
        Setting-06.xaml.cs, VulModellenBlok) - één plek in plaats van
        verspreid onder elke keuzelijst, en ook zonder dat twee rollen die
        toevallig hetzelfde model gebruiken (bijvoorbeeld Daily chat en
        Afbeeldingen allebei op gemma3) een eigen, uit de pas lopend kopietje
        van dezelfde instelling laten zien.

        Zelfde breedte (1568) en kaartopmaak als de andere kaarten - op de
        randdikte na: die staat hier bewust vast op 2 (niet
        {DynamicResource RegionBorderThickness}, zoals bij de andere
        kaarten) zodat hij gelijk blijft aan het Code-groepje verderop, dat
        om dezelfde reden ook vast op 2 staat.
    -->
    <Border MinWidth="480" CornerRadius="{DynamicResource RadiusMedium}" BorderThickness="2"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            HorizontalAlignment="Stretch" VerticalAlignment="Top">
        <StackPanel Margin="20,16">
            <TextBlock Text="{DynamicResource T_AiTitel}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text01Brush}" />

            <TextBlock Text="{DynamicResource T_AiServer}" Margin="0,14,0,4" FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ProviderLmStudio" Content="LM Studio" GroupName="AiServer"
                             AutomationProperties.AutomationId="AiServerLmStudio"
                             Checked="Provider_Checked" Style="{DynamicResource ServerChoiceStyle}" />
                <RadioButton x:Name="ProviderOllama" Content="Ollama" GroupName="AiServer" Margin="8,0,0,0"
                             AutomationProperties.AutomationId="AiServerOllama"
                             Checked="Provider_Checked" Style="{DynamicResource ServerChoiceStyle}" />
            </StackPanel>

            <TextBlock Text="{DynamicResource T_AiAdres}" Margin="0,16,0,4" FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <TextBox x:Name="ServerUrlBox" Style="{DynamicResource InputBoxStyle}"
                     AutomationProperties.AutomationId="AiServerUrl"
                     LostFocus="ServerUrl_LostFocus" KeyDown="ServerUrl_KeyDown" />

            <!-- De twee algemene modellen naast elkaar: de kaart is breed
                 genoeg, en zo staat bij elkaar wat bij elkaar hoort. -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource T_AiDailychatModel}" Margin="0,0,0,4" FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <ComboBox x:Name="ChatModelPicker" Height="34" ItemTemplate="{StaticResource ModelkeuzeTemplate}"
                              AutomationProperties.AutomationId="AiChatModel"
                              SelectionChanged="Model_SelectionChanged" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource T_AiEmbeddingmodel}" Margin="0,0,0,4" FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <ComboBox x:Name="EmbedModelPicker" Height="34" ItemTemplate="{StaticResource ModelkeuzeTemplate}"
                              AutomationProperties.AutomationId="AiEmbedModel"
                              SelectionChanged="Model_SelectionChanged" />
                </StackPanel>
            </Grid>

            <!-- Het Code-groepje: twee samenhorende modellen met een eigen
                 taak binnen codevoorstellen (LocalAiStudio.App). Codemodel
                 GEEFT het antwoord/voorstel; Controlemodel controleert dat
                 antwoord achteraf tegen dezelfde broncode - een ANDER model
                 laten narekenen wat het eerste beweerde, in plaats van een
                 model zijn eigen werk laten nakijken. Beide optioneel: leeg
                 valt terug op Codemodel, en die weer op het chatmodel
                 hierboven (zie AiServerSettings). Apart omkaderd zodat
                 duidelijk is dat deze twee bij elkaar horen. -->
            <TextBlock Text="{DynamicResource T_AiCodeGroep}" Margin="0,16,0,4" FontSize="{DynamicResource FontSizeSmall}"
                       FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" CornerRadius="{DynamicResource RadiusMedium}" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource T_AiCodemodel}" Margin="0,0,0,4" FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <ComboBox x:Name="CodeModelPicker" Height="34" ItemTemplate="{StaticResource ModelkeuzeTemplate}"
                                  AutomationProperties.AutomationId="AiCodeModel"
                                  SelectionChanged="Model_SelectionChanged" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource T_AiControlemodel}" Margin="0,0,0,4" FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <ComboBox x:Name="ControleModelPicker" Height="34" ItemTemplate="{StaticResource ModelkeuzeTemplate}"
                                  AutomationProperties.AutomationId="AiControleModel"
                                  SelectionChanged="Model_SelectionChanged" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Afbeeldingen: het model dat een bijgevoegd plaatje (bijvoorbeeld
                 een screenshot) leest en beschrijft. De beschrijving gaat als
                 tekst naar het gewone model, dat zelf geen beelden hoeft te
                 kunnen - zie AiServerSettings.BeeldModel. Optioneel. -->
            <TextBlock Text="{DynamicResource T_AiBeeldGroep}" Margin="0,16,0,4" FontSize="{DynamicResource FontSizeSmall}"
                       FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" CornerRadius="{DynamicResource RadiusMedium}" Padding="12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource T_AiBeeldmodel}" Margin="0,0,0,4" FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <ComboBox x:Name="BeeldModelPicker" Height="34" ItemTemplate="{StaticResource ModelkeuzeTemplate}"
                              AutomationProperties.AutomationId="AiBeeldModel"
                              SelectionChanged="Model_SelectionChanged" />
                </StackPanel>
            </Border>

            <!-- Hoeveel EXTRA ronden Projectassistent (LocalAiStudio.App)
                 mag vragen om meer projectcontext als het model zelf zegt
                 dat de eerste lading niet genoeg was - zie
                 AiSettings.MaxContextRondes. 0 zet het automatisch
                 doorvragen uit. Staat bewust bij de modellen: het gaat
                 over hoe er met ChatModel/CodeModel gesproken wordt, niet
                 over de ondergrens hieronder (die gaat over Zoeken). -->
            <TextBlock x:Name="ContextRondesLabel" Text="" Margin="0,16,0,6" FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <Slider x:Name="ContextRondesSlider" Minimum="0" Maximum="5" Value="3"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    AutomationProperties.AutomationId="AiContextRondes"
                    ValueChanged="ContextRondes_ValueChanged"
                    PreviewMouseUp="ContextRondes_Vastgezet" KeyUp="ContextRondes_Vastgezet"
                    Style="{DynamicResource SliderAccentStyle}" />

            <!-- Hoe lang een app op een antwoord van een model wacht -
                 geldt voor elk model dat via de broker aangeroepen wordt
                 (chat, code, controle), dus hier en niet per applicatie
                 apart - zie AiSettings.ChatTimeoutSeconden. Een app die
                 zelf een broker-verbinding opzet (zoals LocalAiStudio.App)
                 geeft deze waarde bij het opstarten mee; een wijziging hier
                 geldt dus pas na een herstart van die apps. -->
            <TextBlock x:Name="ChatTimeoutLabel" Text="" Margin="0,16,0,6" FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <Slider x:Name="ChatTimeoutSlider" Minimum="1" Maximum="60" Value="5"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    AutomationProperties.AutomationId="AiChatTimeout"
                    ValueChanged="ChatTimeout_ValueChanged"
                    PreviewMouseUp="ChatTimeout_Vastgezet" KeyUp="ChatTimeout_Vastgezet"
                    Style="{DynamicResource SliderAccentStyle}" />

            <!-- De ondergrens voor semantisch zoeken: onder dit percentage
                 (cosinus-gelijkenis) geldt een treffer als onzeker in
                 plaats van gevonden - zie Zoeken.xaml in LocalAiStudio.App
                 en Jabasoft.Broker/SearchIndexStore.MinimumGelijkenis.
                 Hoort net als de modellen hierboven bij de broker en dus
                 bij de hele familie, niet bij deze applicatie alleen. -->
            <TextBlock x:Name="OndergrensLabel" Text="" Margin="0,16,0,6" FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <Slider x:Name="OndergrensSlider" Minimum="0" Maximum="100" Value="50"
                    TickFrequency="5"
                    AutomationProperties.AutomationId="AiOndergrens"
                    ValueChanged="Ondergrens_ValueChanged"
                    PreviewMouseUp="Ondergrens_Vastgezet" KeyUp="Ondergrens_Vastgezet"
                    Style="{DynamicResource SliderAccentStyle}" />

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button x:Name="RefreshModelsButton" Content="{DynamicResource T_AiVernieuwen}"
                        AutomationProperties.AutomationId="AiRefreshModels"
                        Click="RefreshModels_Click" Style="{DynamicResource AccentButtonStyle}" />
                <TextBlock x:Name="StatusText" Margin="14,0,0,0" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="AiStatus"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>

            <!-- MODELLEN: één plek voor elk model op de ingestelde server -
                 een korte eigen notitie waar het goed in is, de kwaliteit
                 (sterren) en hoe lang het mag nadenken. Bovenaan een
                 STANDAARD-regel die geldt voor elk model daaronder zonder
                 eigen waarde (zie AiServerSettings.StandaardSleutel). De
                 rijen worden in code-behind opgebouwd (VulModellenBlok):
                 hoeveel modellen er zijn hangt af van wat de server
                 aanbiedt. -->
            <ToggleButton x:Name="ModellenToggle" Margin="0,20,0,0" HorizontalAlignment="Left"
                          HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0"
                          Cursor="Hand" Click="ModellenToggle_Click"
                          AutomationProperties.AutomationId="AiModellenToggle">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <DockPanel Background="{TemplateBinding Background}">
                            <Path x:Name="Pijl" DockPanel.Dock="Left" Data="M0,0 L8,5 L0,10 Z"
                                  Fill="{DynamicResource AccentBrush}" Width="8" Height="10" Stretch="Fill"
                                  VerticalAlignment="Center" Margin="0,0,10,0"
                                  RenderTransformOrigin="0.5,0.5" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pijl" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
                <TextBlock Text="{DynamicResource T_AiModellenTitel}" FontSize="{DynamicResource FontSizeTitle}"
                           FontWeight="SemiBold" Foreground="{DynamicResource Text01Brush}" />
            </ToggleButton>

            <!-- Dicht bij het opstarten van deze kaart (zie Setting06 in
                 code-behind): een lijst van soms tientallen modellen met
                 elk een eigen notitie hoort niet standaard open te staan. -->
            <StackPanel x:Name="ModellenSectie" Visibility="Collapsed" Margin="0,10,0,0">
                <TextBlock Text="{DynamicResource T_AiModellenUitleg}" Margin="0,0,0,10" TextWrapping="Wrap"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource TextMutedBrush}" />

                <!-- Kolomkoppen boven de tabel - ZELFDE kolomopbouw (vaste
                     breedtes + de rekbare kolom) als elke rij in BouwModelRij
                     (Setting-06.xaml.cs), zodat de koppen precies boven hun
                     kolom blijven staan, ook als de kaart breder/smaller wordt. -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="2" Text="{DynamicResource T_AiModellenKwaliteitKop}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Grid.Column="3" Text="{DynamicResource T_AiTaakChat}" TextAlignment="Center" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" ToolTip="{DynamicResource T_AiTaakChatTip}" />
                    <TextBlock Grid.Column="4" Text="{DynamicResource T_AiTaakCode}" TextAlignment="Center" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" ToolTip="{DynamicResource T_AiTaakCodeTip}" />
                    <TextBlock Grid.Column="5" Text="{DynamicResource T_AiTaakControle}" TextAlignment="Center" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" ToolTip="{DynamicResource T_AiTaakControleTip}" />
                    <TextBlock Grid.Column="6" Text="{DynamicResource T_AiTaakBeeld}" TextAlignment="Center" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" ToolTip="{DynamicResource T_AiTaakBeeldTip}" />
                    <TextBlock Grid.Column="7" Text="{DynamicResource T_AiTaakZoeken}" TextAlignment="Center" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" ToolTip="{DynamicResource T_AiTaakZoekenTip}" />
                </Grid>

                <StackPanel x:Name="ModellenBlok" AutomationProperties.AutomationId="AiModellenBlok" />
            </StackPanel>
        </StackPanel>
    </Border>

</UserControl>
