<UserControl x:Class="Jabasoft.App.Controls.Navigatiemenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theming="clr-namespace:Stylebook.Components.Theming;assembly=Stylebook.Components"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" MinHeight="400"
             d:DesignWidth="256" d:DesignHeight="846">

    <!-- Design-time-only: geeft Visual Studio/Blend's Designer een
         thema-context (kleuren, lettertype) - deze class library heeft
         zelf geen App.xaml die dat normaal doet. mc:Ignorable="d" zorgt
         dat dit bij het echt compileren/draaien volledig wegvalt. -->
    <d:UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </d:UserControl.Resources>

    <!--
        LCARS-navigatiemenu met drie knoppen: Main, Stylebook en Settings.
        Dashboard en Componenten zijn eruit gehaald tot ze ook echt iets
        doen.

        Het component navigeert NIET zelf: elke knop meldt via het event
        ItemSelected welke gekozen is, en de app eromheen beslist wat er
        dan gebeurt (zie Navigatiemenu.xaml.cs en, voor Jabasoft,
        Jabasoft.App/MainWindow.xaml.cs). Zo kan een volgende app hetzelfde
        menu gebruiken met zijn eigen bestemmingen, zonder dat er
        app-kennis in dit gedeelde component komt te zitten.

        Dit vervangt in Jabasoft.App de oude app-launcherlijst die eerder
        in code-behind werd opgebouwd; van die lijst is alleen Stylebook
        overgebleven, als knop.

        Hoogte mag meebewegen, breedte niet: de knoppen staan in de
        *-rij en de zwarte strook met de versiebalk in de Auto-rij
        eronder, dus die blijven onderaan plakken hoe hoog het menu ook
        wordt. De breedte ligt vast in de Menu-kolom van Basis (256).
    -->
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="2"
                    Background="{DynamicResource TextMutedBrush}"
                    theming:CornerRadiusParts.TopLeft="48"
                    theming:CornerRadiusParts.BottomLeft="48"/>

            <StackPanel Grid.Row="0"
                        theming:MarginParts.Left="{DynamicResource SpaceMedium}"
                        theming:MarginParts.Top="{DynamicResource SpaceLarge}"
                        theming:MarginParts.Right="{DynamicResource SpaceMedium}"
                        theming:MarginParts.Bottom="{DynamicResource SpaceLarge}">

                <!-- Main: terug naar het hoofdscherm. Welk scherm dat is,
                     bepaalt de app die dit menu gebruikt - zie de notitie
                     hierboven over ItemSelected. -->
                <Button x:Name="MainButton" Content="Main" Click="MenuItem_Click" Foreground="{DynamicResource AccentForegroundBrush}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" HorizontalContentAlignment="Left"
                        theming:MarginParts.Bottom="{DynamicResource SpaceSmall}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{DynamicResource AccentBrush}"
                                    theming:CornerRadiusParts.TopLeft="{DynamicResource RadiusXLarge}"
                                    theming:CornerRadiusParts.TopRight="{DynamicResource RadiusXLarge}"
                                    theming:CornerRadiusParts.BottomRight="{DynamicResource RadiusXLarge}"
                                    theming:PaddingParts.Left="{DynamicResource SpaceMedium}"
                                    theming:PaddingParts.Top="{DynamicResource SpaceSmall}"
                                    theming:PaddingParts.Right="{DynamicResource SpaceMedium}"
                                    theming:PaddingParts.Bottom="{DynamicResource SpaceSmall}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12 3l9 8h-3v9h-5v-6h-2v6H6v-9H3z" Fill="{DynamicResource Text01Brush}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"
                                          theming:MarginParts.Right="{DynamicResource SpaceSmall}" />
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrushDark}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrushDark}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="StylebookButton" Content="Stylebook" Click="MenuItem_Click" Foreground="{DynamicResource AccentForegroundBrush}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" HorizontalContentAlignment="Left"
                        theming:MarginParts.Bottom="{DynamicResource SpaceSmall}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{DynamicResource AccentBrush}"
                                    theming:CornerRadiusParts.TopLeft="{DynamicResource RadiusXLarge}"
                                    theming:CornerRadiusParts.TopRight="{DynamicResource RadiusXLarge}"
                                    theming:CornerRadiusParts.BottomRight="{DynamicResource RadiusXLarge}"
                                    theming:PaddingParts.Left="{DynamicResource SpaceMedium}"
                                    theming:PaddingParts.Top="{DynamicResource SpaceSmall}"
                                    theming:PaddingParts.Right="{DynamicResource SpaceMedium}"
                                    theming:PaddingParts.Bottom="{DynamicResource SpaceSmall}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M13 13v8h8v-8h-8zM3 21h8v-8H3v8zM3 3v8h8V3H3zm13.66-1.31L11 7.34 16.66 13l5.66-5.66-5.66-5.65z" Fill="{DynamicResource Text01Brush}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"
                                          theming:MarginParts.Right="{DynamicResource SpaceSmall}" />
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrushDark}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrushDark}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="SettingsButton" Content="Settings" Click="MenuItem_Click" Foreground="{DynamicResource AccentForegroundBrush}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" HorizontalContentAlignment="Left"
                        theming:MarginParts.Bottom="{DynamicResource SpaceSmall}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{DynamicResource AccentBrush}"
                                    theming:CornerRadiusParts.TopLeft="{DynamicResource RadiusXLarge}"
                                    theming:CornerRadiusParts.TopRight="{DynamicResource RadiusXLarge}"
                                    theming:CornerRadiusParts.BottomRight="{DynamicResource RadiusXLarge}"
                                    theming:PaddingParts.Left="{DynamicResource SpaceMedium}"
                                    theming:PaddingParts.Top="{DynamicResource SpaceSmall}"
                                    theming:PaddingParts.Right="{DynamicResource SpaceMedium}"
                                    theming:PaddingParts.Bottom="{DynamicResource SpaceSmall}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" Fill="{DynamicResource Text01Brush}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"
                                          theming:MarginParts.Right="{DynamicResource SpaceSmall}" />
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrushDark}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrushDark}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>

            <!-- Onderkant van het menu: blijft altijd onderaan staan, ook als
                 de hoogte van het menu verandert (Grid.Row="1", Auto-hoog,
                 na de *-rij met de knoppen hierboven - geen vaste pixel-
                 marges meer die alleen bij één specifieke hoogte kloppen). -->
            <StackPanel Grid.Row="1">
                <!-- Dun accentstrookje boven de versiebalk - bewust géén
                     LCARS-hoekafronding, daarvoor is 8px te dun.

                     Geen vaste Width meer (stond op 256): met de
                     SPACING-instelling krijgt het menublok een zwarte rand
                     en wordt het smaller dan 256, en dan stak deze balk er
                     aan de rechterkant uit. Uitrekken volgt de werkelijke
                     breedte van het blok. -->
                <Border Background="{DynamicResource BackgroundBrush}"
                        HorizontalAlignment="Stretch"
                        Height="8" />

                <!-- Versie-indicator: wordt bij iedere wijziging aan deze app
                     handmatig opgehoogd (laatste cijfer +1). -->
                <Border x:Name="VersionBar"
                        theming:CornerRadiusParts.TopLeft="0"
                        theming:CornerRadiusParts.TopRight="0"
                        theming:CornerRadiusParts.BottomRight="0"
                        theming:CornerRadiusParts.BottomLeft="48"
                        Background="{DynamicResource AccentBrush}"
                        HorizontalAlignment="Stretch"
                        Height="40">
                    <TextBlock x:Name="VersionText"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Stretch"
                               Height="20"
                               Margin="30,0,16,0"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               Text="V 0.1.0.46" />
                </Border>
            </StackPanel>
        </Grid>
    </Border>

</UserControl>
