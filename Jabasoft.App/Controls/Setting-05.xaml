<UserControl x:Class="Jabasoft.App.Controls.Setting05"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" Width="1568">

    <!-- Design-time-only: geeft Visual Studio/Blend's Designer een
         thema-context (kleuren, lettertype) - deze class library heeft
         zelf geen App.xaml die dat normaal doet. mc:Ignorable="d" zorgt
         dat dit bij het echt compileren/draaien volledig wegvalt. -->
    <d:UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </d:UserControl.Resources>

    <!--
        Instellingenkaart: BORDER. De dikte van de kaderrand om de
        instellingenkaarten en de infoblokken in de header - die stonden
        eerder allemaal los op 2. 0 tot 10 px in hele pixels, standaard 3.

        Staat op het scherm direct onder SPACING; die twee horen bij
        elkaar (de ruimte tussen de blokken en de rand eromheen).

        Werkt echt door: schuiven zet RegionBorderThickness om via
        LayoutManager.ApplyRegionBorder, en alles wat op dat moment op het
        scherm staat verspringt mee. Zie Setting-05.xaml.cs.
    -->
    <Border MinWidth="480" CornerRadius="{DynamicResource RadiusMedium}" BorderThickness="{DynamicResource RegionBorderThickness}"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            HorizontalAlignment="Stretch" VerticalAlignment="Top">
        <StackPanel Margin="20,16">
            <TextBlock Text="{DynamicResource T_BorderTitel}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text01Brush}" />

            <TextBlock x:Name="BorderLabel" Text=""
                       Margin="0,14,0,6" FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <Slider x:Name="BorderSlider" Minimum="0" Maximum="10" Value="3"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    ValueChanged="BorderSlider_ValueChanged"
                    Style="{DynamicResource SliderAccentStyle}" />

            <Button x:Name="ResetBorderButton" Content="{DynamicResource T_BorderTerug}"
                    Margin="0,16,0,0" Click="ResetBorder_Click"
                    Style="{DynamicResource AccentButtonStyle}" />
        </StackPanel>
    </Border>

</UserControl>
