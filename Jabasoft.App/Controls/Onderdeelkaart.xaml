<UserControl x:Class="Jabasoft.App.Controls.Onderdeelkaart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <!-- Design-time-only: geeft Visual Studio/Blend's Designer een
         thema-context (kleuren, lettertype) - deze class library heeft
         zelf geen App.xaml die dat normaal doet. mc:Ignorable="d" zorgt
         dat dit bij het echt compileren/draaien volledig wegvalt. -->
    <d:UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </d:UserControl.Resources>

    <!--
        Waar gaan de tokens heen: per onderdeel van een applicatie (Daily chat,
        Projectassistent, Codevoorstel, Afbeelding, Controle, Zoeken...) een
        staaf met het aantal tokens en aanroepen over de laatste vier weken,
        het zwaarste bovenaan. De staven worden in code-behind gebouwd (zie
        Onderdeelkaart.xaml.cs): welke onderdelen er zijn hangt af van wat er
        in de database staat.

        Zelfde kaartopmaak als het totaal en de grafiek erboven.
    -->
    <Border MinWidth="480" CornerRadius="{DynamicResource RadiusMedium}" BorderThickness="{DynamicResource RegionBorderThickness}"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            HorizontalAlignment="Stretch" VerticalAlignment="Top">
        <StackPanel Margin="20,16">
            <TextBlock Text="{DynamicResource T_TokensOnderdeelTitel}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text01Brush}" />
            <TextBlock x:Name="Onderschrift" Margin="0,6,0,12"
                       FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Text="{DynamicResource T_TokensOnderdeelLeeg}" />

            <StackPanel x:Name="Staven" AutomationProperties.AutomationId="TokensOnderdelen" />
        </StackPanel>
    </Border>

</UserControl>
