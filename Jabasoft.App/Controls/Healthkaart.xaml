<UserControl x:Class="Jabasoft.App.Controls.Healthkaart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" Width="1568">

    <!-- Design-time-only: geeft Visual Studio/Blend's Designer een
         thema-context (kleuren, lettertype) - deze class library heeft
         zelf geen App.xaml die dat normaal doet. mc:Ignorable="d" zorgt
         dat dit bij het echt compileren/draaien volledig wegvalt. -->
    <d:UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </d:UserControl.Resources>

    <!--
        Eén controle in het gezondheidsoverzicht: een bolletje in dezelfde
        drie kleuren als de SYSTEM HEALTH-pil, de naam, en daaronder in één
        regel wat er gevonden is. Rechts hoe lang die controle duurde -
        daar zie je aan welke voorziening traag opkomt.

        Zelfde kaartopmaak en breedte als de instellingenkaarten.
    -->
    <Border MinWidth="480" CornerRadius="{DynamicResource RadiusMedium}" BorderThickness="{DynamicResource RegionBorderThickness}"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            HorizontalAlignment="Stretch" VerticalAlignment="Top">
        <Grid Margin="20,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Ellipse x:Name="Bolletje" Grid.Column="0" Width="14" Height="14"
                     VerticalAlignment="Center" Margin="0,0,14,0"
                     Fill="{DynamicResource HealthBusyBrush}" />

            <StackPanel Grid.Column="1">
                <TextBlock x:Name="NaamText" Text="controle"
                           AutomationProperties.AutomationId="HealthkaartNaam"
                           FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text01Brush}" />
                <TextBlock x:Name="MeldingText" Text="" Margin="0,4,0,0" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="HealthkaartMelding"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>

            <TextBlock x:Name="DuurText" Grid.Column="2" Text=""
                       VerticalAlignment="Center" Margin="14,0,0,0"
                       FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource TextMutedBrush}" />
        </Grid>
    </Border>

</UserControl>
