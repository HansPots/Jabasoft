<UserControl x:Class="Jabasoft.App.Controls.Tokenweek"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" Width="1568">

    <!-- Design-time-only: geeft Visual Studio/Blend's Designer een
         thema-context (kleuren, lettertype) - deze class library heeft
         zelf geen App.xaml die dat normaal doet. mc:Ignorable="d" zorgt
         dat dit bij het echt compileren/draaien volledig wegvalt. -->
    <d:UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </d:UserControl.Resources>

    <!--
        Eén week in het tokenoverzicht: een regel met het weektotaal die je
        kunt openklappen om de losse aanroepen te zien.

        Geen WPF-Expander: die brengt zijn eigen driehoekje en opmaak mee
        die niets met dit thema te maken hebben. Het is hier een
        ToggleButton met een eigen template (de kopregel) en daaronder een
        vak dat mee open- en dichtgaat - zelfde aanpak als de knoppen in
        het menu.

        De regels worden PAS opgehaald als je de week openklapt; zie de
        code-behind. Een jaar aan weken opent dus niet een jaar aan
        databaseregels.
    -->
    <Border MinWidth="480" CornerRadius="{DynamicResource RadiusMedium}" BorderThickness="{DynamicResource RegionBorderThickness}"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            HorizontalAlignment="Stretch" VerticalAlignment="Top">
        <StackPanel>

            <ToggleButton x:Name="Kop" Checked="Kop_Omgezet" Unchecked="Kop_Omgezet"
                          AutomationProperties.AutomationId="TokenweekKop"
                          Background="Transparent" BorderThickness="0" Cursor="Hand"
                          HorizontalContentAlignment="Stretch">
                <!-- Alleen het driehoekje en de achtergrond zitten in de
                     template; de teksten staan als INHOUD van de knop, want
                     wat in een template staat is vanuit de code-behind niet
                     bij naam te bereiken (eigen naamruimte). -->
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource RadiusMedium}"
                                Padding="20,14">
                            <DockPanel>
                                <!-- Wijst naar rechts als het dicht is, naar
                                     beneden als het open staat. -->
                                <Path x:Name="Pijl" DockPanel.Dock="Left" Data="M0,0 L8,5 L0,10 Z"
                                      Fill="{DynamicResource AccentBrush}"
                                      Width="8" Height="10" Stretch="Fill"
                                      VerticalAlignment="Center" Margin="0,0,14,0"
                                      RenderTransformOrigin="0.5,0.5" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BackgroundBrush}" />
                            </Trigger>
                            <!-- Een trigger kan alleen een genoemd ELEMENT
                                 aanspreken, geen transformatie daarbinnen -
                                 vandaar dat hier de hele RenderTransform
                                 vervangen wordt in plaats van alleen de hoek. -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pijl" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="WeekText" Text="week"
                                   AutomationProperties.AutomationId="TokenweekNaam"
                                   FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text01Brush}" />
                        <TextBlock x:Name="PeriodeText" Text="" Margin="0,4,0,0"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>

                    <TextBlock x:Name="TotaalText" Grid.Column="1" Text="0"
                               AutomationProperties.AutomationId="TokenweekTotaal"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" />
                </Grid>
            </ToggleButton>

            <!-- Het opengeklapte deel. Collapsed en niet Hidden: dicht neemt
                 het dan ook geen hoogte in. -->
            <StackPanel x:Name="Regelvak" Visibility="Collapsed" Margin="20,0,20,14" Grid.IsSharedSizeScope="True">
                <TextBlock x:Name="MeldingText" Visibility="Collapsed" Margin="22,0,0,8"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource TextMutedBrush}" />

                <!-- Kolomkoppen. Dezelfde SharedSizeGroup-namen als de regels
                     eronder, zodat de koppen precies boven hun kolom staan
                     ook al staan ze in een ander raster. -->
                <Grid Margin="22,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Tijd" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="App" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Getal" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Getal" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Getal" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource T_TokensKopTijd}" Margin="0,0,16,0" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Grid.Column="1" Text="{DynamicResource T_TokensKopApp}" Margin="0,0,16,0" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Grid.Column="2" Text="{DynamicResource T_TokensKopModel}" Margin="0,0,16,0" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Grid.Column="3" Text="{DynamicResource T_TokensKopPrompt}" Margin="0,0,16,0" TextAlignment="Right" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Grid.Column="4" Text="{DynamicResource T_TokensKopAntwoord}" Margin="0,0,16,0" TextAlignment="Right" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Grid.Column="5" Text="{DynamicResource T_TokensKopTotaal}" TextAlignment="Right" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextMutedBrush}" />
                </Grid>

                <ItemsControl x:Name="Regels" Margin="22,0,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Tijd" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="App" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Getal" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Getal" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Getal" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Tijd}" Margin="0,0,16,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding App}" Margin="0,0,16,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding Model}" Margin="0,0,16,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Column="3" Text="{Binding Prompt}" Margin="0,0,16,0" TextAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Column="4" Text="{Binding Antwoord}" Margin="0,0,16,0" TextAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Grid.Column="5" Text="{Binding Totaal}" TextAlignment="Right" Foreground="{DynamicResource Text01Brush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
    </Border>

</UserControl>
