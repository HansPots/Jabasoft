<UserControl x:Class="Jabasoft.App.Controls.Setting04"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" Width="1568">

    <!-- Design-time-only: geeft Visual Studio/Blend's Designer een
         thema-context (kleuren, lettertype) - deze class library heeft
         zelf geen App.xaml die dat normaal doet. mc:Ignorable="d" zorgt
         dat dit bij het echt compileren/draaien volledig wegvalt. -->
    <d:UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </d:UserControl.Resources>

    <!--
        Instellingenkaart: SPACING. De zwarte rand om elk van de vijf
        blokken van een pagina - header, menu, inhoud, actie en footer.
        0 tot 5 px, met hele pixels (TickFrequency/IsSnapToTickEnabled),
        want een halve pixel zou alleen maar vaag randje geven.

        Zelfde breedte (1568) en kaartopmaak als de andere kaarten, en
        dezelfde gedeelde stijlen voor de schuifbalk en de knop.

        Werkt wel echt: schuiven zet RegionGapThickness om via
        LayoutManager.ApplyRegionGap, en elke Basis die op dat moment op
        het scherm staat verspringt mee. Zie Setting-04.xaml.cs.
    -->
    <!-- De breedte staat op het UserControl hierboven (1568) en niet meer
         op deze Border. Zo blijft de kaart op zichzelf even breed als
         altijd - ook op het Regions-canvas in het Stylebook - maar kan wie
         hem plaatst er Width="Auto" op zetten en hem laten meerekken. Dat
         doet Regions/Inhoud/Instellingen, zodat het instellingenscherm in
         de app geen horizontale schuifbalk nodig heeft. -->
    <Border MinWidth="480" CornerRadius="6" BorderThickness="2"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            HorizontalAlignment="Stretch" VerticalAlignment="Top">
        <StackPanel Margin="20,16">
            <TextBlock Text="SPACING" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text01Brush}" />

            <TextBlock x:Name="GapLabel" Text="Space around each block (header, menu, content, action, footer) &#8212; 0 px"
                       Margin="0,14,0,6" FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <Slider x:Name="GapSlider" Minimum="0" Maximum="5" Value="0"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    ValueChanged="GapSlider_ValueChanged"
                    Style="{DynamicResource SliderAccentStyle}" />

            <Button x:Name="ResetGapButton" Content="Reset to default (0 px)"
                    Margin="0,16,0,0" Click="ResetGap_Click"
                    Style="{DynamicResource AccentButtonStyle}" />
        </StackPanel>
    </Border>

</UserControl>
