<UserControl x:Class="Jabasoft.App.Controls.Tokentotaal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" Width="1568">

    <!-- Design-time-only: geeft Visual Studio/Blend's Designer een
         thema-context (kleuren, lettertype) - deze class library heeft
         zelf geen App.xaml die dat normaal doet. mc:Ignorable="d" zorgt
         dat dit bij het echt compileren/draaien volledig wegvalt. -->
    <d:UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </d:UserControl.Resources>

    <!--
        De balk bovenaan het tokenoverzicht: alles bij elkaar opgeteld,
        over alle weken en alle applicaties heen.

        Zelfde kaartopmaak en breedte als de instellingenkaarten - het
        tokenscherm is bewust in dezelfde stijl gebouwd, zodat het
        herkenbaar bij elkaar hoort.
    -->
    <Border MinWidth="480" CornerRadius="{DynamicResource RadiusMedium}" BorderThickness="{DynamicResource RegionBorderThickness}"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            HorizontalAlignment="Stretch" VerticalAlignment="Top">
        <Grid Margin="20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="TOKENS" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text01Brush}" />
                <TextBlock x:Name="Onderschrift" Margin="0,6,0,0"
                           AutomationProperties.AutomationId="TokensOnderschrift"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="Nog niets geteld" />
            </StackPanel>

            <!-- Het getal waar het om gaat, rechts en groot. -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock x:Name="TotaalText" Text="0"
                           AutomationProperties.AutomationId="TokensTotaal"
                           FontSize="42" FontWeight="Bold" HorizontalAlignment="Right"
                           Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="tokens totaal" HorizontalAlignment="Right"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>
        </Grid>
    </Border>

</UserControl>
