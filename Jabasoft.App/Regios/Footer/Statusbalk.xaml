<UserControl x:Class="Jabasoft.App.Regios.Footer.Statusbalk"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Jabasoft.App.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="24"
             d:DesignWidth="1920">

    <!-- Design-time-only: geeft Visual Studio/Blend's Designer een
         thema-context (kleuren, lettertype) - deze class library heeft
         zelf geen App.xaml die dat normaal doet. mc:Ignorable="d" zorgt
         dat dit bij het echt compileren/draaien volledig wegvalt. -->
    <d:UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </d:UserControl.Resources>

    <!--
        Footer-regio component: de vijf statuspillen op een rij.

        Vijf gelijke sterkolommen, dus elke pil krijgt exact een vijfde van
        de breedte en ze rekken alle vijf mee als het venster breder of
        smaller wordt. Width="Auto" op elke pil zet de eigen vaste breedte
        van dat component uit (288/384/436) zodat de kolom de maat bepaalt;
        zonder dat zouden ze op hun oorspronkelijke breedte blijven staan.

        GEEN vaste hoogte op dit component: het is zo hoog als de pillen
        (24) plus de SPACING-rand die ze eromheen krijgen. Stond hier wel
        een vaste 24, dan ging die rand van de pillen af en werden ze bij
        SPACING 5 tot 14 px afgeknipt. De footerrij in Basis staat op Auto
        en volgt dit, dus de footer groeit netjes mee. Tussen de pillen 8px lucht,
        aan de buitenkanten niet - dat is de ruimte die de SPACING-
        instelling eventueel al geeft.
    -->
    <Grid x:Name="PillRow">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <controls:Footer01 x:Name="HealthPill" Grid.Column="0" Width="Auto" />
        <controls:Footer02 x:Name="CpuPill" Grid.Column="1" Width="Auto" Margin="{DynamicResource RegionGapLeftThickness}" />
        <controls:Footer03 x:Name="RamPill" Grid.Column="2" Width="Auto" Margin="{DynamicResource RegionGapLeftThickness}" />
        <controls:Footer04 x:Name="VramPill" Grid.Column="3" Width="Auto" Margin="{DynamicResource RegionGapLeftThickness}" />
        <controls:Footer05 Grid.Column="4" Width="Auto" Margin="{DynamicResource RegionGapLeftThickness}" />

        <!-- Splitters tussen de pillen, in de SPACING-ruimte die de pil
             rechts ervan toch al vrijhoudt - geen eigen kolom dus. Staat
             SPACING op 0, dan is er niets te pakken.

             BasedOnAlignment met HorizontalAlignment "Left": de splitter
             pakt de kolom ERVOOR en zijn EIGEN kolom, dus de pil links en
             de pil rechts van de greep. Niet "PreviousAndNext" - die telt
             vanaf de kolom waar de splitter in zit en slaat die over. -->
        <GridSplitter Grid.Column="1" Width="{DynamicResource RegionGapSize}"
                      HorizontalAlignment="Left" VerticalAlignment="Stretch"
                      Background="Transparent" ShowsPreview="False"
                      ResizeBehavior="BasedOnAlignment" ResizeDirection="Columns"
                      DragCompleted="Splitter_DragCompleted" />
        <GridSplitter Grid.Column="2" Width="{DynamicResource RegionGapSize}"
                      HorizontalAlignment="Left" VerticalAlignment="Stretch"
                      Background="Transparent" ShowsPreview="False"
                      ResizeBehavior="BasedOnAlignment" ResizeDirection="Columns"
                      DragCompleted="Splitter_DragCompleted" />
        <GridSplitter Grid.Column="3" Width="{DynamicResource RegionGapSize}"
                      HorizontalAlignment="Left" VerticalAlignment="Stretch"
                      Background="Transparent" ShowsPreview="False"
                      ResizeBehavior="BasedOnAlignment" ResizeDirection="Columns"
                      DragCompleted="Splitter_DragCompleted" />
        <GridSplitter Grid.Column="4" Width="{DynamicResource RegionGapSize}"
                      HorizontalAlignment="Left" VerticalAlignment="Stretch"
                      Background="Transparent" ShowsPreview="False"
                      ResizeBehavior="BasedOnAlignment" ResizeDirection="Columns"
                      DragCompleted="Splitter_DragCompleted" />
    </Grid>

</UserControl>
