<UserControl x:Class="Jabasoft.App.Regios.Inhoud.Health"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <!-- Design-time-only: geeft Visual Studio/Blend's Designer een
         thema-context (kleuren, lettertype) - deze class library heeft
         zelf geen App.xaml die dat normaal doet. mc:Ignorable="d" zorgt
         dat dit bij het echt compileren/draaien volledig wegvalt. -->
    <d:UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </d:UserControl.Resources>

    <!--
        Inhoud-regio component: het gezondheidsoverzicht, waar de
        Health-knop in het menu naartoe schakelt.

        Boven de stand van het geheel met een knop om alles opnieuw te
        laten controleren, daaronder een kaart per controle. De pil in de
        footer zegt alleen "Ready" of "Error"; hier staat per voorziening
        wat er wel en niet draait.

        Opzet gelijk aan het instellingenscherm en het tokenoverzicht:
        schuifvak met kaarten onder elkaar, dezelfde marges, dezelfde
        meelopende SPACING.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{DynamicResource RegionGapRightThickness}">

            <Border MinWidth="480" CornerRadius="{DynamicResource RadiusMedium}" BorderThickness="{DynamicResource RegionBorderThickness}"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <Grid Margin="20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse x:Name="Bolletje" Grid.Column="0" Width="18" Height="18"
                             VerticalAlignment="Center" Margin="0,0,14,0"
                             Fill="{DynamicResource HealthBusyBrush}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource T_HealthTitel}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text01Brush}" />
                        <TextBlock x:Name="StandText" Text="Starting" Margin="0,4,0,0"
                                   AutomationProperties.AutomationId="HealthStand"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>

                    <Button x:Name="OpnieuwButton" Grid.Column="2" Content="{DynamicResource T_HealthOpnieuw}"
                            AutomationProperties.AutomationId="HealthOpnieuw"
                            VerticalAlignment="Center" Click="Opnieuw_Click"
                            Style="{DynamicResource AccentButtonStyle}" />
                </Grid>
            </Border>

            <!-- De kaarten per controle worden in code-behind bijgemaakt:
                 welke controles er zijn bepaalt de applicatie, niet dit
                 scherm. -->
            <ItemsControl x:Name="Controles">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>

</UserControl>
