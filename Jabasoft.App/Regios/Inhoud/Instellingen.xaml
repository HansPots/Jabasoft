<UserControl x:Class="Jabasoft.App.Regios.Inhoud.Instellingen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Jabasoft.App.Controls"
             xmlns:aistudio="clr-namespace:LocalAiStudio.App.Controls;assembly=LocalAiStudio.App"
             xmlns:imagefunn="clr-namespace:ImageFunn.App.Controls;assembly=ImageFunn.App"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <!-- Design-time-only: geeft Visual Studio/Blend's Designer een
         thema-context (kleuren, lettertype) - deze class library heeft
         zelf geen App.xaml die dat normaal doet. mc:Ignorable="d" zorgt
         dat dit bij het echt compileren/draaien volledig wegvalt. -->
    <d:UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </d:UserControl.Resources>

    <UserControl.Resources>
        <!-- Het kopje boven elk onderdeel. Groter dan de titel van een kaart
             en in de accentkleur, zodat je bij het scrollen ziet waar het
             volgende onderdeel begint. -->
        <Style x:Key="SectiekopStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Margin" Value="4,24,0,8" />
        </Style>
    </UserControl.Resources>

    <!--
        Inhoud-regio component: Jabasoft.App's instellingenscherm - waar de
        Settings-knop in het menu en de knop in de Actie-rail naartoe
        schakelen (zie Jabasoft.App/MainWindow.xaml.cs). Vroeger via
        XamlReader.Parse live uit de database gelezen door SettingsView, nu
        een echt, gecompileerd component dat SettingsView rechtstreeks host.

        Dit component IS de instellingenpagina van Jabasoft: het stapelt de
        losse kaarten uit Controls/ onder elkaar, in deze volgorde:
        Setting-01 THEMA, Setting-02 FONT, Setting-04 SPACING en
        Setting-03 REFRESH TIME. De nummers lopen dus niet gelijk met de
        volgorde op het scherm - SPACING kwam er later bij maar hoort op de
        derde plek. Een kaart erbij of eraf is één regel hier; de kaart
        zelf blijft op zichzelf te bekijken in de Controls-modus van het
        Stylebook.

        Width="Auto" op elke kaart zet hun eigen standaardbreedte (1568)
        uit, zodat ze hier meerekken met het inhoudsvak. Die standaard
        blijft wel op de kaarten zelf staan - anders zouden ze op het
        Regions-canvas in het Stylebook inklappen.

        Omdat er niets meer opzij wegvalt staat de horizontale schuifbalk
        UIT; met "Auto" zou hij bij een pixel afrondingsverschil alsnog
        verschijnen. Verticaal blijft hij op Auto, want meer kaarten dan er
        passen kan gewoon.
    -->
    <!--
        Het ENE instellingenscherm van de applicatie: alles staat hier, met
        een kopje per onderdeel. AI Studio, TabStudio en ImageFunn hebben
        geen eigen instellingenpagina meer; hun kaarten komen uit hun eigen
        bibliotheek (ze bewaren in hun eigen voorkeuren) maar staan hier.
        De Instellingen-knop in het menu van AI Studio komt hier uit, bij
        het kopje AI Studio (zie ToonSectie).
    -->
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- Ruimte rechts, zodat de kaarten niet tegen de schuifbalk aan
             liggen. Volgt de SPACING-instelling, net als al het andere. -->
        <StackPanel x:Name="Kaarten" Margin="{DynamicResource RegionGapRightThickness}">

            <!-- Algemeen: geldt voor de hele applicatie. Taal bovenaan: die
                 bepaalt hoe de rest van dit scherm te lezen is. -->
            <TextBlock x:Name="KopAlgemeen" Text="{DynamicResource T_SectieAlgemeen}" Style="{StaticResource SectiekopStyle}" Margin="4,0,0,8" />
            <controls:Setting07 Width="Auto" />
            <controls:Setting01 Width="Auto" Margin="{DynamicResource RegionGapTopThickness}" />
            <controls:Setting02 Width="Auto" Margin="{DynamicResource RegionGapTopThickness}" />
            <controls:Setting04 Width="Auto" Margin="{DynamicResource RegionGapTopThickness}" />
            <controls:Setting05 Width="Auto" Margin="{DynamicResource RegionGapTopThickness}" />
            <controls:Setting03 Width="Auto" Margin="{DynamicResource RegionGapTopThickness}" />

            <!-- AI: server en modellen, gedeeld door AI Studio, ImageFunn en
                 de broker. -->
            <TextBlock x:Name="KopAi" Text="{DynamicResource T_SectieAi}" Style="{StaticResource SectiekopStyle}" />
            <controls:Setting06 x:Name="AiKaart" Width="Auto" />

            <TextBlock x:Name="KopAiStudio" Text="{DynamicResource T_SectieAiStudio}" Style="{StaticResource SectiekopStyle}" />
            <aistudio:Settings />

            <TextBlock x:Name="KopTabStudio" Text="{DynamicResource T_SectieTabStudio}" Style="{StaticResource SectiekopStyle}" />
            <TextBlock Text="{DynamicResource T_SectieGeenInstellingen}" Margin="4,0,0,0"
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeBody}" />

            <TextBlock x:Name="KopImageFunn" Text="{DynamicResource T_SectieImageFunn}" Style="{StaticResource SectiekopStyle}" />
            <imagefunn:Beeldserviceinstellingen Margin="0,0,0,6" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
