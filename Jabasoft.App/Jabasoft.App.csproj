<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- Gedeelde styling/theming - zelfde cross-repo-referentie-patroon
         als de oude Shared.UI/Shared.Telemetry-referenties, nu op
         Stylebook.Components. Geeft Jabasoft's eigen chrome dezelfde
         {DynamicResource}-tokens als Stylebook, zonder hier ooit een
         kleur te hoeven hardcoden. -->
    <ProjectReference Include="..\..\Jabasoft.Stylebook\Stylebook.Components\Stylebook.Components.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
