<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- Het pictogram van de applicatie: zowel het .exe-bestand in de
         verkenner als het venster en de taakbalk krijgen dit. Ook de
         snelkoppeling op het bureaublad leest het hiervandaan, dus die
         blijft kloppen zonder dat er een los .ico ergens naast staat. -->
    <ApplicationIcon>Jabasoft.ico</ApplicationIcon>

    <!-- Het versienummer van deze applicatie. Elke wijziging: laatste cijfer
         +1. Dit is de ENIGE plek waar het staat - het menu leest het uit de
         gebouwde assembly (zie Jabasoft.Base/AppVersion), zodat het scherm
         niet kan afwijken van wat er werkelijk draait. Het exe-bestand
         draagt het hierdoor ook: te zien in de eigenschappen van het
         bestand en in een foutmelding. -->
    <Version>0.1.0.85</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Gedeelde styling/theming - zelfde cross-repo-referentie-patroon
         als de oude Shared.UI/Shared.Telemetry-referenties, nu op
         Stylebook.Components. Geeft Jabasoft's eigen chrome dezelfde
         {DynamicResource}-tokens als Stylebook, zonder hier ooit een
         kleur te hoeven hardcoden. -->
    <ProjectReference Include="..\..\Jabasoft.Stylebook\Stylebook.Components\Stylebook.Components.csproj" />

    <!-- AiBrokerProcessLauncher: Jabasoft is vaak de eerste app die de
         gebruiker opstart, dus ook hier de broker alvast aanzwengelen
         zodat Stylebook (en straks TabStudio/LocalAiStudio) 'm al
         draaiend aantreffen. -->
    <ProjectReference Include="..\..\Jabasoft.Base\Jabasoft.Base.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
